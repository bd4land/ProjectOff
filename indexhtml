<!DOCTYPE html>
<html lang="bn">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Connector — ডিভাইস টু ডিভাইস</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Bengali:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">
<style>
  :root{
    --bg: #EFEDE6;
    --panel: #FBFAF6;
    --panel-2: #F2F0E9;
    --ink: #201D17;
    --ink-soft: #5C574B;
    --line: #D9D4C6;
    --copper: #B5601F;
    --copper-soft: #E7D3BC;
    --ok: #3A7D5C;
    --ok-soft: #D7E9DE;
    --danger: #A63B2A;
    --danger-soft: #F1DCD6;
    --shadow: 0 1px 0 rgba(32,29,23,0.06);
    --radius: 3px;
  }
  :root:not([data-theme="light"]) {
    @media (prefers-color-scheme: dark) {
      --bg: #16140F;
      --panel: #211D16;
      --panel-2: #2A251C;
      --ink: #EEE9DD;
      --ink-soft: #A79E8C;
      --line: #3A3327;
      --copper: #E08A3C;
      --copper-soft: #4A3521;
      --ok: #6FBB93;
      --ok-soft: #22362B;
      --danger: #E0705A;
      --danger-soft: #3E241E;
    }
  }
  :root[data-theme="dark"]{
    --bg: #16140F;
    --panel: #211D16;
    --panel-2: #2A251C;
    --ink: #EEE9DD;
    --ink-soft: #A79E8C;
    --line: #3A3327;
    --copper: #E08A3C;
    --copper-soft: #4A3521;
    --ok: #6FBB93;
    --ok-soft: #22362B;
    --danger: #E0705A;
    --danger-soft: #3E241E;
  }

  *{ box-sizing: border-box; }
  html,body{ margin:0; padding:0; }
  body{
    background: var(--bg);
    color: var(--ink);
    font-family: 'Noto Sans Bengali', 'Segoe UI', system-ui, sans-serif;
    font-size: 16px;
    line-height: 1.55;
    padding: 28px 16px 60px;
    min-height: 100vh;
  }
  .mono{ font-family: 'JetBrains Mono', ui-monospace, monospace; }

  .wrap{ max-width: 760px; margin: 0 auto; }

  header.top{
    display:flex; align-items:baseline; justify-content:space-between; gap:12px;
    margin-bottom: 28px; flex-wrap: wrap;
  }
  header.top h1{
    font-size: 1.5rem; font-weight: 700; margin: 0; letter-spacing: -0.01em;
  }
  header.top .tag{
    color: var(--ink-soft); font-size: 0.85rem;
  }

  .plate{
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    padding: 22px;
    margin-bottom: 18px;
  }

  .plate h2{
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: none;
    color: var(--ink-soft);
    margin: 0 0 14px;
    padding-bottom: 10px;
    border-bottom: 1px solid var(--line);
  }

  /* ---- jack / connection visual ---- */
  .patch{
    display:flex; align-items:center; justify-content:center; gap: 14px;
    padding: 18px 0 6px;
  }
  .device{
    display:flex; flex-direction:column; align-items:center; gap:8px;
    width: 92px;
  }
  .device svg{ width:40px; height:40px; }
  .device .label{ font-size: 0.72rem; color: var(--ink-soft); text-align:center; }
  .cable{
    flex:1; max-width: 200px; height: 3px; background: var(--line);
    position: relative; border-radius: 2px; overflow: hidden;
  }
  .cable .pulse{
    position:absolute; inset:0; background: var(--copper);
    transform: scaleX(0); transform-origin: left;
    transition: transform 0.6s cubic-bezier(.4,0,.2,1);
  }
  .cable.live .pulse{ transform: scaleX(1); }
  .cable .dot{
    position:absolute; top:50%; left:-6px; width:9px; height:9px; border-radius:50%;
    background: var(--copper); transform: translateY(-50%);
    opacity:0; transition: opacity .3s;
  }
  .cable.live .dot{
    opacity:1;
    animation: travel 1.6s linear infinite;
  }
  @keyframes travel{
    0%{ left:-6px; }
    100%{ left:100%; }
  }

  .status-line{
    text-align:center; font-size: 0.85rem; color: var(--ink-soft); margin-top:4px;
  }
  .status-line.live{ color: var(--ok); font-weight:600; }

  /* ---- your code ---- */
  .code-row{
    display:flex; align-items:center; gap:10px; flex-wrap:wrap;
  }
  .code-box{
    font-size: 1.5rem; font-weight:700; letter-spacing: 0.06em;
    background: var(--panel-2); border: 1px dashed var(--line);
    border-radius: var(--radius); padding: 10px 16px;
    color: var(--copper);
  }
  button{
    font-family: inherit; font-size: 0.85rem; font-weight: 600;
    border-radius: var(--radius); border: 1px solid var(--line);
    padding: 10px 16px; cursor:pointer; background: var(--panel-2); color: var(--ink);
    transition: background .15s, border-color .15s;
  }
  button:hover{ border-color: var(--copper); }
  button:disabled{ opacity:0.45; cursor:not-allowed; }
  button.primary{
    background: var(--copper); border-color: var(--copper); color: #FBFAF6;
  }
  button.primary:hover{ filter: brightness(1.06); }
  .hint{ font-size: 0.78rem; color: var(--ink-soft); margin-top:10px; }

  .connect-row{
    display:flex; gap:10px; margin-top:6px; flex-wrap:wrap;
  }
  input[type=text]{
    font-family: 'JetBrains Mono', monospace; font-size: 1rem;
    padding: 10px 12px; border-radius: var(--radius); border: 1px solid var(--line);
    background: var(--panel-2); color: var(--ink); flex:1; min-width: 160px;
    letter-spacing: 0.05em; text-transform: uppercase;
  }
  input[type=text]:focus{ outline: 2px solid var(--copper); outline-offset: 1px; }

  /* ---- drop zone ---- */
  .drop{
    border: 1.5px dashed var(--line); border-radius: var(--radius);
    padding: 26px 16px; text-align:center; color: var(--ink-soft);
    cursor:pointer; transition: border-color .15s, background .15s;
  }
  .drop:hover, .drop.over{ border-color: var(--copper); background: var(--copper-soft); }
  .drop strong{ color: var(--ink); }

  /* ---- transfer list ---- */
  .xfer{
    border: 1px solid var(--line); border-radius: var(--radius);
    padding: 12px 14px; margin-top: 10px; background: var(--panel-2);
  }
  .xfer-top{ display:flex; justify-content:space-between; gap:10px; font-size:0.85rem; margin-bottom:8px; }
  .xfer-top .name{ font-weight:600; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
  .xfer-top .size{ color: var(--ink-soft); flex-shrink:0; }
  .bar{ height:6px; background: var(--line); border-radius:4px; overflow:hidden; }
  .bar > div{ height:100%; background: var(--ok); width:0%; transition: width .15s; }
  .xfer.done .bar > div{ background: var(--ok); }
  .xfer-foot{ display:flex; justify-content:space-between; align-items:center; margin-top:8px; }
  .xfer-foot .pct{ font-size:0.75rem; color: var(--ink-soft); }

  /* ---- log ---- */
  .log{
    font-family:'JetBrains Mono', monospace; font-size: 0.75rem; color: var(--ink-soft);
    max-height: 160px; overflow-y:auto; display:flex; flex-direction:column-reverse;
  }
  .log div{ padding: 3px 0; border-bottom: 1px solid var(--line); }
  .log div:last-child{ border-bottom:none; }

  .badge{
    display:inline-block; font-size:0.68rem; font-weight:700; padding:2px 8px;
    border-radius: 999px; background: var(--ok-soft); color: var(--ok);
  }
  .badge.warn{ background: var(--danger-soft); color: var(--danger); }

  footer{
    max-width:760px; margin: 30px auto 0; font-size: 0.78rem; color: var(--ink-soft);
    border-top: 1px solid var(--line); padding-top: 16px;
  }

  @media (max-width: 480px){
    .code-box{ font-size: 1.2rem; }
    .device{ width: 70px; }
    .device svg{ width:32px; height:32px; }
  }
</style>
</head>
<body>
<div class="wrap">

  <header class="top">
    <h1>🔌 Connector</h1>
    <div class="tag">ফেজ ০ — ব্রাউজার টু ব্রাউজার ফাইল টেস্ট</div>
  </header>

  <div class="plate">
    <h2>সংযোগ</h2>
    <div class="patch">
      <div class="device">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="4" y="2" width="16" height="20" rx="2"/><line x1="10" y1="19" x2="14" y2="19"/></svg>
        <div class="label">এই ডিভাইস</div>
      </div>
      <div class="cable" id="cable"><div class="pulse"></div><div class="dot"></div></div>
      <div class="device">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="4" width="18" height="14" rx="1.5"/><line x1="3" y1="17" x2="21" y2="17"/></svg>
        <div class="label">অন্য ডিভাইস</div>
      </div>
    </div>
    <div class="status-line" id="statusLine">সিগন্যালিং সার্ভারে যুক্ত হচ্ছে…</div>

    <div style="margin-top:20px; padding-top:16px; border-top:1px solid var(--line);">
      <div style="font-size:0.8rem; color:var(--ink-soft); margin-bottom:8px;">আপনার কোড — এটা অন্যজনকে দিন</div>
      <div class="code-row">
        <div class="code-box mono" id="myCode">••••••</div>
        <button id="copyBtn">কপি করুন</button>
        <button id="copyLinkBtn">লিংক কপি</button>
      </div>
    </div>

    <div style="margin-top:18px;">
      <div style="font-size:0.8rem; color:var(--ink-soft); margin-bottom:8px;">অথবা অন্যজনের কোড দিয়ে যুক্ত হন</div>
      <div class="connect-row">
        <input type="text" id="peerInput" placeholder="যেমন: 7QK9F2" maxlength="8">
        <button class="primary" id="connectBtn">কানেক্ট করুন</button>
      </div>
    </div>
    <div class="hint">সার্ভার শুধু এই ছোট্ট কোড বিনিময়ে সাহায্য করে। এরপরের সব ডেটা — ফাইল সমেত — দুই ব্রাউজারের মধ্যে সরাসরি যায়, কোনো সার্ভার সেটা ছুঁয়ে দেখে না।</div>
  </div>

  <div class="plate" id="sendPlate" style="display:none;">
    <h2>ফাইল পাঠান</h2>
    <div class="drop" id="dropZone">
      <strong>ফাইল টেনে আনুন</strong> অথবা ক্লিক করে বেছে নিন
      <input type="file" id="fileInput" multiple style="display:none;">
    </div>
    <div id="sendList"></div>
  </div>

  <div class="plate" id="recvPlate" style="display:none;">
    <h2>আসা ফাইল</h2>
    <div id="recvList"></div>
  </div>

  <div class="plate">
    <h2>লগ</h2>
    <div class="log" id="log"></div>
  </div>

  <footer>
    এটা একটা পরীক্ষামূলক প্রোটোটাইপ — signaling-এর জন্য PeerJS-এর পাবলিক ফ্রি ব্রোকার ব্যবহার করা হয়েছে (নিজস্ব প্ল্যাটফর্মে নিজের সার্ভার লাগবে)। একবারে একটা করে ফাইল, ব্রাউজার বন্ধ হলে ট্রান্সফার থেমে যাবে — এগুলোই পরের ধাপে ঠিক করার বিষয়।
  </footer>
</div>

<script src="https://cdn.jsdelivr.net/npm/peerjs@1.5.4/dist/peerjs.min.js"></script>
<script>
(function(){
  const logEl = document.getElementById('log');
  function log(msg, cls){
    const d = document.createElement('div');
    if(cls) d.style.color = cls;
    const t = new Date().toLocaleTimeString('en-GB');
    d.textContent = `[${t}] ${msg}`;
    logEl.appendChild(d);
    logEl.scrollTop = logEl.scrollHeight;
  }

  const statusLine = document.getElementById('statusLine');
  const cable = document.getElementById('cable');
  const myCodeEl = document.getElementById('myCode');
  const copyBtn = document.getElementById('copyBtn');
  const copyLinkBtn = document.getElementById('copyLinkBtn');
  const peerInput = document.getElementById('peerInput');
  const connectBtn = document.getElementById('connectBtn');
  const sendPlate = document.getElementById('sendPlate');
  const recvPlate = document.getElementById('recvPlate');
  const dropZone = document.getElementById('dropZone');
  const fileInput = document.getElementById('fileInput');
  const sendList = document.getElementById('sendList');
  const recvList = document.getElementById('recvList');

  const CHUNK = 16 * 1024;
  const NS = 'bdconn-'; // namespace to avoid clashing with other apps on the shared public broker

  function shortCode(){
    const chars = 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789'; // no ambiguous chars
    let s = '';
    for(let i=0;i<6;i++) s += chars[Math.floor(Math.random()*chars.length)];
    return s;
  }

  let downloadsApi = null;
  (async function(){
    try{
      if(window.claude && window.claude.use){
        downloadsApi = await window.claude.use('downloads');
      }
    }catch(e){ /* not available, fine */ }
  })();

  const myCode = shortCode();
  myCodeEl.textContent = myCode;

  const peer = new Peer(NS + myCode, { debug: 1 });
  let activeConn = null;

  const urlParams = new URLSearchParams(location.search);
  const autoConnect = urlParams.get('connect');
  if(autoConnect){ peerInput.value = autoConnect.toUpperCase(); }

  peer.on('open', (id) => {
    log('সিগন্যালিং সার্ভারে যুক্ত হয়েছে। আপনার কোড: ' + myCode);
    statusLine.textContent = 'অপেক্ষা করছে — কোড শেয়ার করুন অথবা অন্যের কোড দিন';
    if(autoConnect) doConnect(autoConnect);
  });

  peer.on('error', (err) => {
    log('সিগন্যালিং এরর: ' + err.type, 'var(--danger)');
    statusLine.textContent = 'সংযোগ সমস্যা — পেজ রিফ্রেশ করে আবার চেষ্টা করুন';
  });

  peer.on('connection', (conn) => {
    log('ইনকামিং কানেকশন: ' + conn.peer.replace(NS,''));
    bindConn(conn);
  });

  copyBtn.onclick = () => {
    navigator.clipboard.writeText(myCode).then(()=>{
      copyBtn.textContent = 'কপি হয়েছে ✓';
      setTimeout(()=> copyBtn.textContent = 'কপি করুন', 1500);
    });
  };
  copyLinkBtn.onclick = () => {
    const url = location.origin + location.pathname + '?connect=' + myCode;
    navigator.clipboard.writeText(url).then(()=>{
      copyLinkBtn.textContent = 'লিংক কপি হয়েছে ✓';
      setTimeout(()=> copyLinkBtn.textContent = 'লিংক কপি', 1500);
    });
  };

  connectBtn.onclick = () => {
    const code = peerInput.value.trim().toUpperCase();
    if(!code) return;
    doConnect(code);
  };
  peerInput.addEventListener('keydown', (e)=>{ if(e.key === 'Enter') connectBtn.click(); });

  function doConnect(code){
    if(code === myCode){ log('নিজের কোড দিয়ে কানেক্ট করা যায় না', 'var(--danger)'); return; }
    log('কানেক্ট করার চেষ্টা: ' + code + ' ...');
    statusLine.textContent = 'কানেক্ট হচ্ছে…';
    const conn = peer.connect(NS + code, { reliable: true });
    bindConn(conn);
  }

  function bindConn(conn){
    activeConn = conn;
    conn.on('open', () => {
      log('✓ সংযোগ স্থাপিত হয়েছে: ' + conn.peer.replace(NS,''));
      statusLine.textContent = 'যুক্ত আছে — সরাসরি ব্রাউজার টু ব্রাউজার';
      statusLine.classList.add('live');
      cable.classList.add('live');
      sendPlate.style.display = 'block';
      recvPlate.style.display = 'block';
      connectBtn.disabled = true;
      peerInput.disabled = true;
    });
    conn.on('close', () => {
      log('সংযোগ বিচ্ছিন্ন হয়েছে', 'var(--danger)');
      statusLine.textContent = 'সংযোগ বিচ্ছিন্ন — আবার কানেক্ট করুন';
      statusLine.classList.remove('live');
      cable.classList.remove('live');
      connectBtn.disabled = false;
      peerInput.disabled = false;
      activeConn = null;
    });
    conn.on('error', (err) => log('কানেকশন এরর: ' + err, 'var(--danger)'));
    conn.on('data', (data) => handleIncoming(data));
  }

  // ---------- sending ----------
  dropZone.onclick = () => fileInput.click();
  dropZone.addEventListener('dragover', (e)=>{ e.preventDefault(); dropZone.classList.add('over'); });
  dropZone.addEventListener('dragleave', ()=> dropZone.classList.remove('over'));
  dropZone.addEventListener('drop', (e)=>{
    e.preventDefault(); dropZone.classList.remove('over');
    handleFiles(e.dataTransfer.files);
  });
  fileInput.addEventListener('change', (e)=> handleFiles(e.target.files));

  function fmtBytes(n){
    if(n < 1024) return n + ' B';
    if(n < 1024*1024) return (n/1024).toFixed(1) + ' KB';
    if(n < 1024*1024*1024) return (n/(1024*1024)).toFixed(1) + ' MB';
    return (n/(1024*1024*1024)).toFixed(2) + ' GB';
  }

  function handleFiles(fileList){
    if(!activeConn){ log('আগে কানেক্ট করুন', 'var(--danger)'); return; }
    Array.from(fileList).forEach(sendFile);
  }

  async function sendFile(file){
    const id = 'f' + Math.random().toString(36).slice(2,10);
    const row = document.createElement('div');
    row.className = 'xfer';
    row.innerHTML = `
      <div class="xfer-top"><span class="name">${escapeHtml(file.name)}</span><span class="size">${fmtBytes(file.size)}</span></div>
      <div class="bar"><div style="width:0%"></div></div>
      <div class="xfer-foot"><span class="pct">পাঠানো হচ্ছে…</span><span class="badge">পাঠাচ্ছি</span></div>`;
    sendList.appendChild(row);
    const bar = row.querySelector('.bar > div');
    const pct = row.querySelector('.pct');
    const badge = row.querySelector('.badge');

    activeConn.send({ type:'start', id, name:file.name, size:file.size, mime:file.type||'application/octet-stream' });

    let offset = 0;
    while(offset < file.size){
      const slice = file.slice(offset, offset + CHUNK);
      const buf = await slice.arrayBuffer();
      // simple backpressure: wait if channel buffer is filling up
      while(activeConn.dataChannel && activeConn.dataChannel.bufferedAmount > 4 * 1024 * 1024){
        await new Promise(r => setTimeout(r, 30));
      }
      activeConn.send(buf);
      offset += buf.byteLength;
      const p = Math.min(100, Math.round((offset/file.size)*100));
      bar.style.width = p + '%';
      pct.textContent = p + '%';
    }
    activeConn.send({ type:'end', id });
    row.classList.add('done');
    pct.textContent = 'সম্পন্ন';
    badge.textContent = 'পাঠানো হয়েছে';
    log('পাঠানো শেষ: ' + file.name);
  }

  // ---------- receiving ----------
  const incoming = {}; // id -> {name,size,mime,chunks:[],received}

  function handleIncoming(data){
    if(data && typeof data === 'object' && !(data instanceof ArrayBuffer) && !ArrayBuffer.isView(data) && data.type){
      if(data.type === 'start'){
        incoming[data.id] = { name:data.name, size:data.size, mime:data.mime, chunks:[], received:0 };
        const row = document.createElement('div');
        row.className = 'xfer';
        row.id = 'recv-' + data.id;
        row.innerHTML = `
          <div class="xfer-top"><span class="name">${escapeHtml(data.name)}</span><span class="size">${fmtBytes(data.size)}</span></div>
          <div class="bar"><div style="width:0%"></div></div>
          <div class="xfer-foot"><span class="pct">আসছে…</span><span class="badge">গ্রহণ করছি</span></div>`;
        recvList.appendChild(row);
        log('ফাইল আসা শুরু: ' + data.name + ' (' + fmtBytes(data.size) + ')');
      } else if(data.type === 'end'){
        finishReceiving(data.id);
      }
      return;
    }
    // binary chunk — attribute to the most recent unfinished transfer
    const ids = Object.keys(incoming);
    if(ids.length === 0) return;
    const id = ids[ids.length - 1];
    const rec = incoming[id];
    const chunk = data instanceof ArrayBuffer ? data : (data.buffer || data);
    rec.chunks.push(chunk);
    rec.received += chunk.byteLength;
    const row = document.getElementById('recv-' + id);
    if(row){
      const p = Math.min(100, Math.round((rec.received/rec.size)*100));
      row.querySelector('.bar > div').style.width = p + '%';
      row.querySelector('.pct').textContent = p + '%';
    }
  }

  async function finishReceiving(id){
    const rec = incoming[id];
    if(!rec) return;
    const blob = new Blob(rec.chunks, { type: rec.mime });
    const row = document.getElementById('recv-' + id);
    row.classList.add('done');
    const badge = row.querySelector('.badge');
    const foot = row.querySelector('.xfer-foot');
    badge.textContent = 'সম্পন্ন';
    row.querySelector('.pct').textContent = fmtBytes(rec.received);

    const saveBtn = document.createElement('button');
    saveBtn.className = 'primary';
    saveBtn.style.marginLeft = '8px';
    saveBtn.textContent = 'ডাউনলোড করুন';
    saveBtn.onclick = async () => {
      if(downloadsApi){
        try{
          saveBtn.disabled = true;
          saveBtn.textContent = 'সেভ হচ্ছে…';
          await downloadsApi.save({ filename: rec.name, data: blob });
          saveBtn.textContent = 'সেভ হয়েছে ✓';
        }catch(err){
          saveBtn.disabled = false;
          saveBtn.textContent = 'ডাউনলোড করুন';
          log('সেভ ব্যর্থ: ' + (err && err.code ? err.code : err), 'var(--danger)');
        }
      } else {
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url; a.download = rec.name;
        document.body.appendChild(a); a.click(); a.remove();
        setTimeout(()=> URL.revokeObjectURL(url), 4000);
      }
    };
    foot.appendChild(saveBtn);
    log('ফাইল সম্পূর্ণ এসেছে: ' + rec.name);
    delete incoming[id];
  }

  function escapeHtml(s){
    const d = document.createElement('div');
    d.textContent = s;
    return d.innerHTML;
  }
})();
</script>
</body>
</html>
